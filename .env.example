APP_HOST=127.0.0.1
APP_PORT=8000
REDIS_URL=redis://localhost:6379/0
SQLITE_PATH=data/pronunciation.sqlite3
SESSION_TTL_SECONDS=900
MAX_STREAM_LENGTH=2000
MAX_WEBSOCKET_MESSAGE_BYTES=16384
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
WEBSOCKET_AUTH_TOKEN=
ADMIN_API_TOKEN=
VOICE_RMS_THRESHOLD=0.008
WORD_GATE_MISMATCH_MARGIN_THRESHOLD=0.08588068716048952
TEMPORAL_DOWNSAMPLE_FACTOR=2
PHONETIC_ENABLED=false
# Dynamic INT8 is faster on AVX2 CPUs but increases one-time startup work.
PHONETIC_CPU_QUANTIZATION=false
LOG_LEVEL=INFO
LOG_JSON=true
